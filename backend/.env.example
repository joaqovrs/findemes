# Local development values. Copy the lines you need into backend/.env.local (git-ignored).
# These match docker-compose.yml and are NOT used in any shared environment.

# Owner role: migrations only. Services never connect with it.
MIGRATION_DATABASE_URL=postgres://findemes_owner:local_owner_password@127.0.0.1:5432/findemes

# Database tests (`pnpm test:db`): owner role of a LOCAL server; the suite refuses other hosts.
TEST_DATABASE_URL=postgres://findemes_owner:local_owner_password@127.0.0.1:5432/postgres

# Login roles created by `pnpm db:migrate` (at least 16 characters).
API_DB_PASSWORD=local_api_password_change_me
ADMIN_DB_PASSWORD=local_admin_password_change_me

# Fintoc test mode (dashboard > API Keys). Never commit real values.
FINTOC_PUBLIC_KEY=
FINTOC_SECRET_KEY=
