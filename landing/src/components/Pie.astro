---
import { appLink } from '../lib/app-link';

const columns = [
  { title: 'Producto', links: [['Cómo funciona', '#como'], ['Plan Familiar', '#hogar'], ['Planes', '#planes']] },
  {
    title: 'Cuenta',
    links: [
      ['Crear cuenta', appLink('/registro')],
      ['Entrar', appLink('/login')],
      ['Conectar mi banco', appLink('/registro', { conectar: 'fintoc' })],
      ['Modo de prueba', appLink('/demo')],
    ],
  },
  { title: 'Tus datos', links: [['Qué datos guardamos', appLink('privacidad')], ['Preguntas', '#preguntas'], ['Contacto', appLink('contacto')]] },
] as const;
---
<footer class="foot" data-chapter="paper">
  <div class="foot-top">
    <div class="foot-brand">
      <p class="foot-name">Fin de Mes</p>
      <p class="foot-desc">Registra, proyecta y simula tus gastos mes a mes. Solo o en hogar.</p>
    </div>
    <div class="cols">
      {columns.map((c) => (
        <ul><li>{c.title}</li>{c.links.map(([text, href]) => <li><a href={href}>{text}</a></li>)}</ul>
      ))}
    </div>
  </div>
  <p class="legal">Proyecto de Título, Ingeniería en Informática, 2026. Versión de prueba: los montos de esta página son de ejemplo.</p>
</footer>

<style is:global>
.foot { background: var(--bg); color: var(--ink); padding: clamp(48px, 6vw, 88px) var(--gutter) 24px; }
.foot-top { display: grid; grid-template-columns: repeat(12, 1fr); gap: 40px 24px; }
.foot-brand { grid-column: 1 / 5; }
.foot-name { font-size: var(--step-stmt); font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
.foot-desc { margin-top: 12px; max-width: 30ch; color: var(--muted); }
.foot .cols { grid-column: 6 / 13; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 24px; }
.foot ul { list-style: none; margin: 0; padding: 0; line-height: 1.6; }
.foot li:first-child { font-weight: 600; margin-bottom: 4px; }
.foot li a { text-decoration: none; display: inline-block; padding: 4px 0; color: var(--muted); }
.foot li a:hover { text-decoration: underline; color: var(--ink); }
.foot .legal { margin-top: clamp(40px, 5vw, 72px); font-size: var(--step-small); color: var(--muted); }
@media (max-width: 900px) {
  .foot-brand, .foot .cols { grid-column: 1 / -1; }
  .foot .cols { grid-template-columns: 1fr 1fr; }
}
</style>
