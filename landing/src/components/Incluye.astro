---
import SectionHead from './SectionHead.astro';

// Datos de ejemplo: cuenta de noviembre con el notebook en 12 cuotas.
const sum = [
  { label: 'Sueldo', amount: '$1.150.000' },
  { label: 'Gastos fijos', amount: '−$890.000' },
  { label: 'Cuota del crédito', amount: '−$220.000' },
  { label: 'Cuota del notebook', amount: '−$74.999', kind: 'cause' },
  { label: 'Noviembre', amount: '−$34.999', kind: 'total' },
];

const route = [
  { kind: 'node', text: 'Tú' },
  { kind: 'arrow', text: 'tu clave' },
  { kind: 'node mid', text: 'Fintoc' },
  { kind: 'arrow', text: 'movimientos' },
  { kind: 'node', text: 'Fin de Mes' },
];

const installments = { total: 12, paid: 7 };

// En el orden en que se crearon; ninguno se destaca (CLAUDE.md, regla 4).
const scenarios = [
  { name: 'Sin la compra', lowest: '$160.000', firstNegative: 'Ninguno' },
  { name: 'Notebook en 12 cuotas', lowest: '−$54.995', firstNegative: 'Febrero' },
  { name: 'Notebook en 6 cuotas', lowest: '−$429.990', firstNegative: 'Diciembre' },
];
---
<section class="includes" id="incluye" data-chapter="paper" aria-labelledby="t-inc">
  <SectionHead id="t-inc" icon="check" title="Qué incluye">
    Cuatro piezas, en el orden en que las usas. Fin de Mes no te dice qué hacer: te muestra qué ocurre, en qué mes y qué lo causa.
  </SectionHead>
  <ol class="inc-grid">
    <li class="inc rise" style="--i:0">
      <h3 class="inc-head"><span class="inc-n" aria-hidden="true">1</span><span>Tu banco, sin tu clave</span></h3>
      <ol class="route" aria-label="Recorrido de tu clave bancaria">
        {route.map((r, k) => <li class={r.kind} style={`--k:${k}`}>{r.text}</li>)}
      </ol>
      <p class="cap">Tus movimientos llegan sin que Fin de Mes reciba nunca tu clave. En esta etapa, Fintoc opera en modo de prueba y esos datos aparecen rotulados.</p>
    </li>
    <li class="inc rise" style="--i:1">
      <h3 class="inc-head"><span class="inc-n" aria-hidden="true">2</span><span>Cada cifra, explicada</span></h3>
      <table class="sum num">
        <caption class="vh">Cuenta de noviembre con el notebook en 12 cuotas</caption>
        {sum.map((r) => <tr class={r.kind}><td>{r.label}</td><td>{r.amount}</td></tr>)}
      </table>
      <p class="cap">Cada resultado trae su cuenta. Aquí, la cuota nueva se suma a la del crédito hasta marzo.</p>
    </li>
    <li class="inc rise" style="--i:2">
      <h3 class="inc-head"><span class="inc-n" aria-hidden="true">3</span><span>Tus cuotas, hasta la última</span></h3>
      <div class="dots" role="img" aria-label="Crédito de consumo: 7 de 12 cuotas pagadas. Quedan 5; la última es en marzo de 2027.">
        {Array.from({ length: installments.total }, (_, k) => {
          const paid = k < installments.paid;
          return <i class:list={{ paid, last: k === installments.total - 1 }} style={paid ? `--k:${k}` : undefined}></i>;
        })}
      </div>
      <div class="dots-legend" aria-hidden="true"><span>7 pagadas, quedan 5</span><span>Última: marzo de 2027</span></div>
      <p class="cap">Ves en qué mes se libera cada cuota.</p>
    </li>
    <li class="inc rise" style="--i:3">
      <h3 class="inc-head"><span class="inc-n" aria-hidden="true">4</span><span>Escenarios lado a lado</span></h3>
      <ul class="scen num">
        {scenarios.map((s) => (
          <li><b>{s.name}</b><span class="k">Saldo más bajo</span><span class="v">{s.lowest}</span><span class="k">Primer mes negativo</span><span class="v">{s.firstNegative}</span></li>
        ))}
      </ul>
      <p class="cap">Del mismo tamaño y en el orden en que los creaste. Ninguno aparece como preferible.</p>
    </li>
  </ol>
</section>

<style is:global>
/* campo de color, título y texto juntos */
.includes { margin-top: var(--gap-section); background: var(--field-1); color: var(--field-1-ink); padding: clamp(56px, 6vw, 96px) var(--gutter); }
.includes .sec-icon { background: var(--field-1-ink); color: var(--field-1); }
.includes .sec-sub { color: var(--field-1-ink); }
.inc-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.inc { border: 2px solid var(--field-1-ink); border-radius: var(--r-lg); padding: clamp(20px, 2.2vw, 32px); }
.inc-head { display: flex; align-items: center; gap: 14px; font-size: var(--step-stmt); font-weight: 600; line-height: 1.15; margin-bottom: 20px; }
.inc-n { flex: none; width: 2em; height: 2em; border-radius: 50%; background: var(--field-1-ink); color: var(--field-1); display: grid; place-items: center; font-size: 0.8em; }
.inc-grid .cap { margin-top: 14px; max-width: 46ch; font-size: var(--step-small); }
/* cada cifra, explicada: la cuenta del mes */
.sum { width: 100%; max-width: 480px; border-collapse: collapse; }
.sum td { padding: 6px 10px; }
.sum td + td { text-align: right; }
.sum .cause td { background: var(--field-1-ink); color: var(--field-1); font-weight: 600; }
.sum .cause td:first-child { border-radius: var(--r-sm) 0 0 var(--r-sm); }
.sum .cause td:last-child { border-radius: 0 var(--r-sm) var(--r-sm) 0; }
.sum .total td { padding-top: 14px; font-size: var(--step-stmt); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
/* escenarios lado a lado, del mismo tamaño */
.scen { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.scen li { border: 2px solid var(--field-1-ink); border-radius: var(--r); padding: 14px; display: grid; gap: 2px; align-content: start; transition: transform 160ms var(--ease-out); }
.scen li:hover { transform: translateY(-3px); }
.scen b { font-weight: 600; margin-bottom: 10px; line-height: 1.2; }
.scen .k { font-size: var(--step-small); }
.scen .v { font-weight: 600; margin-bottom: 8px; }
@media (max-width: 520px) { .scen { grid-template-columns: 1fr; } .scen li { grid-template-columns: 1fr auto; column-gap: 12px; } .scen b { grid-column: 1 / -1; } }
/* cuotas como casillas */
.dots { display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; max-width: 520px; }
.dots i { aspect-ratio: 1; border: 2px solid var(--field-1-ink); border-radius: 5px; }
.dots i.paid { background: var(--field-1-ink); }
.dots i.last { position: relative; }
.dots i.last::after { content: ""; position: absolute; inset: 4px; border: 2px solid var(--field-1-ink); border-radius: 2px; }
.dots-legend { max-width: 520px; display: flex; justify-content: space-between; gap: 12px; margin-top: 10px; font-size: var(--step-small); }
/* tu banco: la clave llega solo a Fintoc */
.route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 8px; max-width: 560px; }
.route .node { border: 2px solid var(--field-1-ink); border-radius: var(--r-sm); padding: 10px 12px; font-weight: 600; line-height: 1.15; text-align: center; }
.route .node.mid { background: var(--field-1-ink); color: var(--field-1); }
.route .arrow { display: grid; justify-items: center; font-size: var(--step-small); line-height: 1.2; text-align: center; }
.route .arrow::after { content: "→"; font-size: var(--step-lead); line-height: 1; }
@media (max-width: 760px) { .inc-grid { grid-template-columns: 1fr; } }
@media (max-width: 520px) {
  .route { grid-template-columns: 1fr; justify-items: start; }
  .route .arrow { justify-items: start; padding-left: 12px; grid-auto-flow: column; gap: 8px; align-items: center; }
  .route .arrow::after { content: "↓"; order: -1; }
}

.js .rise .sum tr { opacity: 0; transform: translateY(8px); transition: opacity 450ms var(--ease-out), transform 450ms var(--ease-out); }
.js .rise .sum tr:nth-child(2) { transition-delay: 120ms; } .js .rise .sum tr:nth-child(3) { transition-delay: 240ms; }
.js .rise .sum tr:nth-child(4) { transition-delay: 360ms; } .js .rise .sum tr:nth-child(5) { transition-delay: 560ms; }
.js .rise.in .sum tr { opacity: 1; transform: none; }
.js .rise .dots i.paid { opacity: 0; transform: scale(0.96); transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out); transition-delay: calc(250ms + var(--k, 0) * 80ms); }
.js .rise.in .dots i.paid { opacity: 1; transform: none; }
.js .rise .route > li { opacity: 0; transform: translateX(-10px); transition: opacity 450ms var(--ease-out), transform 450ms var(--ease-out); transition-delay: calc(200ms + var(--k, 0) * 130ms); }
.js .rise.in .route > li { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .js .rise .sum tr, .js .rise .dots i.paid, .js .rise .route > li { opacity: 1; transform: none; transition: none; }
  .scen li:hover { transform: none; }
}
</style>
