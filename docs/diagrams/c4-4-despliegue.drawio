<mxfile host="drawio"><diagram name="c4-4-despliegue" id="c4-4-despliegue"><mxGraphModel adaptiveColors="auto" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;[Diagrama de despliegue] Fin de Mes · ambiente de integración&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Nivel C4 de despliegue · DigitalOcean, región NYC · cada flecha parte de quien inicia la conexión · 11-10-2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="60" as="geometry"/></mxCell><mxCell id="x_fin" value="&lt;b style=&quot;font-size:12px&quot;&gt;Fintoc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · llaves sk_test_]&lt;/span&gt;&lt;br&gt;&lt;br&gt;API de movimientos y widget." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="300" height="130" as="geometry"/></mxCell><mxCell id="x_tbk" value="&lt;b style=&quot;font-size:12px&quot;&gt;Transbank Webpay Plus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · integración]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Formulario y API de pago." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="300" height="130" as="geometry"/></mxCell><mxCell id="x_mail" value="&lt;b style=&quot;font-size:12px&quot;&gt;Proveedor de correo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · por definir]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Correo transaccional." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1340" y="100" width="300" height="130" as="geometry"/></mxCell><mxCell id="x_ts" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tailscale&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · plano de control]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Coordina la tailnet; no ve el tráfico." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1880" y="100" width="300" height="130" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Dispositivo del usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo de despliegue]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Internet · no confiable&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;dashed=1;dashPattern=10 5;strokeWidth=2;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="500" height="760" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: Chrome, Firefox, Edge o Safari]&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="dev"><mxGeometry x="20" y="70" width="460" height="200" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:11px&quot;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Flutter web]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Acceso en memoria; refresh en cookie HttpOnly, Secure, SameSite=Strict." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="br"><mxGeometry x="20" y="60" width="420" height="120" as="geometry"/></mxCell><mxCell id="ph" value="&lt;b&gt;Teléfono&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: Android 10+ o iOS 15+]&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="dev"><mxGeometry x="20" y="300" width="460" height="200" as="geometry"/></mxCell><mxCell id="mob" value="&lt;b style=&quot;font-size:11px&quot;&gt;Aplicación móvil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Flutter]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Refresh en flutter_secure_storage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="ph"><mxGeometry x="20" y="60" width="420" height="120" as="geometry"/></mxCell><mxCell id="wid" value="&lt;b style=&quot;font-size:11px&quot;&gt;Widget de Fintoc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo: JavaScript en el navegador o WebView]&lt;/span&gt;&lt;br&gt;&lt;br&gt;El usuario escribe aquí su clave bancaria." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="dev"><mxGeometry x="40" y="540" width="420" height="190" as="geometry"/></mxCell><mxCell id="do" value="&lt;b&gt;DigitalOcean · región NYC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: proyecto findemes-int]&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="1220" height="1120" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;App Platform · app findemes-int&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: contenedores gestionados]&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="do"><mxGeometry x="30" y="50" width="760" height="520" as="geometry"/></mxCell><mxCell id="edge" value="&lt;b&gt;Borde de App Platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: CDN de Cloudflare, TLS gestionado, dominio propio]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Único punto de entrada público. Sin WAF propio en el MVP.&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="ap"><mxGeometry x="30" y="70" width="340" height="130" as="geometry"/></mxCell><mxCell id="st" value="&lt;b style=&quot;font-size:11px&quot;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: sitio estático]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Sirve /. Mismo dominio que la API." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="ap"><mxGeometry x="30" y="250" width="340" height="110" as="geometry"/></mxCell><mxCell id="mig" value="&lt;b style=&quot;font-size:11px&quot;&gt;Migrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: job previo al despliegue]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Rol dueño." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="ap"><mxGeometry x="30" y="390" width="340" height="100" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:11px&quot;&gt;API pública&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Node.js 24, Fastify · N instancias]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Sirve /v1. Incluye el motor en proceso. Sin estado." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="ap"><mxGeometry x="430" y="210" width="300" height="160" as="geometry"/></mxCell><mxCell id="secr" value="&lt;b&gt;Secretos&lt;/b&gt; como variables cifradas de App Platform: clave AES, clave JWT, sk de Fintoc, credenciales de Webpay, de correo y de cada rol. Nunca en la imagen ni en el repositorio." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="do"><mxGeometry x="820" y="50" width="370" height="110" as="geometry"/></mxCell><mxCell id="vpc" value="&lt;b&gt;VPC findemes-int-vpc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: red privada de la región NYC]&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="do"><mxGeometry x="30" y="620" width="1170" height="470" as="geometry"/></mxCell><mxCell id="pgn" value="&lt;b&gt;PostgreSQL gestionado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: clúster de DigitalOcean]&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6770;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="vpc"><mxGeometry x="30" y="60" width="520" height="380" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:11px&quot;&gt;Base de datos findemes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: PostgreSQL 18]&lt;/span&gt;&lt;br&gt;&lt;br&gt;RLS · roles app_api y app_admin · auditoría solo inserciones, encadenada por hash." style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=11;spacing=6;" vertex="1" parent="pgn"><mxGeometry x="30" y="100" width="460" height="170" as="geometry"/></mxCell><mxCell id="pgnote" value="Trusted sources: salida de App Platform por la VPC e IP privada del Droplet. Respaldo diario y recuperación a un punto en el tiempo (7 días)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="pgn"><mxGeometry x="30" y="290" width="460" height="70" as="geometry"/></mxCell><mxCell id="dro" value="&lt;b&gt;Droplet admin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: Ubuntu LTS + cliente Tailscale]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Cloud Firewall: 0 reglas de entrada. Los servicios escuchan solo en la interfaz de Tailscale.&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D68910;strokeWidth=2;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="vpc"><mxGeometry x="590" y="60" width="560" height="380" as="geometry"/></mxCell><mxCell id="aapi" value="&lt;b style=&quot;font-size:11px&quot;&gt;API de administración&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Node.js 24, Fastify]&lt;/span&gt;&lt;br&gt;&lt;br&gt;TOTP · rol app_admin." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="dro"><mxGeometry x="20" y="130" width="220" height="170" as="geometry"/></mxCell><mxCell id="pan" value="&lt;b style=&quot;font-size:11px&quot;&gt;Panel de administración&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: aplicación web]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Estático." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;dashed=1;dashPattern=8 4;" vertex="1" parent="dro"><mxGeometry x="320" y="130" width="220" height="170" as="geometry"/></mxCell><mxCell id="opd" value="&lt;b&gt;Equipo del operador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Nodo: dispositivo tag:admin de la tailnet]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Aprobación manual · MFA en el proveedor de identidad.&lt;/span&gt;" style="rounded=1;arcSize=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D68910;strokeWidth=2;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1880" y="1080" width="300" height="230" as="geometry"/></mxCell><mxCell id="opb" value="Navegador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#5B6770;strokeColor=#3D464C;fontColor=#ffffff;" vertex="1" parent="opd"><mxGeometry x="30" y="90" width="240" height="60" as="geometry"/></mxCell><mxCell id="prod" value="&lt;b&gt;Producción (fuera del alcance del MVP):&lt;/b&gt; misma topología en otro proyecto de DigitalOcean, con clúster, credenciales y respaldos propios. Webpay requiere afiliación comercial y Fintoc, llaves live y consentimiento según la Ley 21.719." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="1450" width="760" height="70" as="geometry"/></mxCell><mxCell id="r1" value="Descarga la app&lt;br&gt;y llama a /v1&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS 443, TLS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3333;exitDx=0;exitDy=0;entryX=0;entryY=0.3846;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="edge"><mxGeometry relative="1" as="geometry" x="-0.55"></mxGeometry></mxCell><mxCell id="r2" value="Llama a /v1&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS 443, TLS]&lt;/span&gt;" style="endArr