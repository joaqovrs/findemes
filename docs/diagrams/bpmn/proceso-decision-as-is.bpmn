<bpmndi:BPMNEdge id="fp7_di" bpmnElement="fp7"><di:waypoint x="835" y="150"/><di:waypoint x="885" y="150"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp8_di" bpmnElement="fp8"><di:waypoint x="910" y="175"/><di:waypoint x="910" y="260"/><di:waypoint x="955" y="260"/><bpmndi:BPMNLabel><dc:Bounds x="916" y="181" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
