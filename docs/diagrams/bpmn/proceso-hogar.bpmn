<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_hogar" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_hogar">
<bpmn:participant id="pool_admin" name="Administrador de hogar" processRef="proc_admin_hogar"/>
<bpmn:participant id="pool_findemes" name="Fin de Mes" processRef="proc_findemes"/>
<bpmn:participant id="pool_invitado" name="Persona invitada" processRef="proc_invitado"/>
<bpmn:messageFlow id="m1" name="Correo del invitado" sourceRef="i_correo" targetRef="f_inv"/>
<bpmn:messageFlow id="m2" name="Invitación con enlace" sourceRef="f_envia" targetRef="v_recibe"/>
<bpmn:messageFlow id="m3" name="Aceptación" sourceRef="v_acepta" targetRef="f_aceptada"/>
<bpmn:messageFlow id="m4" name="Miembro incorporado" sourceRef="f_inv_fin" targetRef="i_acepto"/>
<bpmn:messageFlow id="m5" name="Gasto y regla" sourceRef="g_guarda" targetRef="f_gasto"/>
<bpmn:messageFlow id="m6" name="Confirmación" sourceRef="f_gasto_fin" targetRef="g_ok"/>
</bpmn:collaboration>
<bpmn:process id="proc_admin_hogar" isExecutable="false">
<bpmn:startEvent id="a_start" name="Decide compartir gastos con su hogar"><bpmn:outgoing>fa1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="a_crear" name="Crear el hogar"><bpmn:incoming>fa1</bpmn:incoming><bpmn:outgoing>fa2</bpmn:outgoing></bpmn:userTask>
<bpmn:subProcess id="sp_invitar" name="Invitar a un miembro"><bpmn:incoming>fa2</bpmn:incoming><bpmn:outgoing>fa3</bpmn:outgoing><bpmn:startEvent id="i_start" name=""><bpmn:outgoing>fi1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="i_correo" name="Ingresar el correo de la persona invitada"><bpmn:incoming>fi1</bpmn:incoming><bpmn:incoming>fi8</bpmn:incoming><bpmn:outgoing>fi2</bpmn:outgoing></bpmn:userTask>
<bpmn:eventBasedGateway id="i_espera" name=""><bpmn:incoming>fi2</bpmn:incoming><bpmn:outgoing>fi3</bpmn:outgoing><bpmn:outgoing>fi4</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="i_plazo" name="7 días sin respuesta"><bpmn:incoming>fi3</bpmn:incoming><bpmn:outgoing>fi5</bpmn:outgoing><bpmn:timerEventDefinition id="i_plazo_def"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="i_decide" name="Decidir si reenviar la invitación"><bpmn:incoming>fi5</bpmn:incoming><bpmn:outgoing>fi6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="i_reenvia" name="¿Reenviar?"><bpmn:incoming>fi6</bpmn:incoming><bpmn:outgoing>fi7</bpmn:outgoing><bpmn:outgoing>fi8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="i_vencida" name="Invitación vencida"><bpmn:incoming>fi7</bpmn:incoming></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="i_acepto" name="Miembro incorporado"><bpmn:incoming>fi4</bpmn:incoming><bpmn:outgoing>fi9</bpmn:outgoing><bpmn:messageEventDefinition id="i_acepto_def"/></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="i_fin" name="Invitación aceptada"><bpmn:incoming>fi9</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fi1" name="" sourceRef="i_start" targetRef="i_correo"/>
<bpmn:sequenceFlow id="fi2" name="" sourceRef="i_correo" targetRef="i_espera"/>
<bpmn:sequenceFlow id="fi3" name="" sourceRef="i_espera" targetRef="i_plazo"/>
<bpmn:sequenceFlow id="fi4" name="" sourceRef="i_espera" targetRef="i_acepto"/>
<bpmn:sequenceFlow id="fi5" name="" sourceRef="i_plazo" targetRef="i_decide"/>
<bpmn:sequenceFlow id="fi6" name="" sourceRef="i_decide" targetRef="i_reenvia"/>
<bpmn:sequenceFlow id="fi7" name="No" sourceRef="i_reenvia" targetRef="i_vencida"/>
<bpmn:sequenceFlow id="fi8" name="Sí" sourceRef="i_reenvia" targetRef="i_correo"/>
<bpmn:sequenceFlow id="fi9" name="" sourceRef="i_acepto" targetRef="i_fin"/></bpmn:subProcess>
<bpmn:subProcess id="sp_gasto" name="Registrar un gasto común y su regla de aporte"><bpmn:incoming>fa3</bpmn:incoming><bpmn:outgoing>fa4</bpmn:outgoing><bpmn:startEvent id="g_start" name=""><bpmn:outgoing>fg1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="g_registra" name="Registrar el gasto común (monto y periodicidad)"><bpmn:incoming>fg1</bpmn:incoming><bpmn:outgoing>fg2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g_tipo" name=""><bpmn:incoming>fg2</bpmn:incoming><bpmn:outgoing>fg3</bpmn:outgoing><bpmn:outgoing>fg4</bpmn:outgoing><bpmn:outgoing>fg5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="g_iguales" name="Repartir en partes iguales"><bpmn:incoming>fg3</bpmn:incoming><bpmn:outgoing>fg6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="g_porc" name="Fijar porcentajes que suman 100 %"><bpmn:incoming>fg4</bpmn:incoming><bpmn:outgoing>fg7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="g_asigna" name="Asignar el gasto a un miembro"><bpmn:incoming>fg5</bpmn:incoming><bpmn:outgoing>fg8</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g_merge" name=""><bpmn:incoming>fg6</bpmn:incoming><bpmn:incoming>fg7</bpmn:incoming><bpmn:incoming>fg8</bpmn:incoming><bpmn:outgoing>fg9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="g_guarda" name="Guardar el gasto y la regla"><bpmn:incoming>fg9</bpmn:incoming><bpmn:outgoing>fg10</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="g_ok" name="Confirmación recibida"><bpmn:incoming>fg10</bpmn:incoming><bpmn:outgoing>fg11</bpmn:outgoing><bpmn:messageEventDefinition id="g_ok_def"/></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="g_end" name=""><bpmn:incoming>fg11</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fg1" name="" sourceRef="g_start" targetRef="g_registra"/>
<bpmn:sequenceFlow id="fg2" name="" sourceRef="g_registra" targetRef="g_tipo"/>
<bpmn:sequenceFlow id="fg3" name="Iguales" sourceRef="g_tipo" targetRef="g_iguales"/>
<bpmn:sequenceFlow id="fg4" name="Porcentajes" sourceRef="g_tipo" targetRef="g_porc"/>
<bpmn:sequenceFlow id="fg5" name="Asignado" sourceRef="g_tipo" targetRef="g_asigna"/>
<bpmn:sequenceFlow id="fg6" name="" sourceRef="g_iguales" targetRef="g_merge"/>
<bpmn:sequenceFlow id="fg7" name="" sourceRef="g_porc" targetRef="g_merge"/>
<bpmn:sequenceFlow id="fg8" name="" sourceRef="g_asigna" targetRef="g_merge"/>
<bpmn:sequenceFlow id="fg9" name="" sourceRef="g_merge" targetRef="g_guarda"/>
<bpmn:sequenceFlow id="fg10" name="" sourceRef="g_guarda" targetRef="g_ok"/>
<bpmn:sequenceFlow id="fg11" name="" sourceRef="g_ok" targetRef="g_end"/></bpmn:subProcess>
<bpmn:endEvent id="a_fin" name="Gastos comunes vigentes para todos"><bpmn:incoming>fa4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fa1" name="" sourceRef="a_start" targetRef="a_crear"/>
<bpmn:sequenceFlow id="fa2" name="" sourceRef="a_crear" targetRef="sp_invitar"/>
<bpmn:sequenceFlow id="fa3" name="" sourceRef="sp_invitar" targetRef="sp_gasto"/>
<bpmn:sequenceFlow id="fa4" name="" sourceRef="sp_gasto" targetRef="a_fin"/>
</bpmn:process>
<bpmn:process id="proc_findemes" isExecutable="false">
<bpmn:startEvent id="f_inv" name="Solicitud de invitación"><bpmn:outgoing>ff1</bpmn:outgoing><bpmn:messageEventDefinition id="f_inv_def"/></bpmn:startEvent>
<bpmn:serviceTask id="f_enlace" name="Generar un enlace de un solo uso con vigencia de 7 días"><bpmn:incoming>ff1</bpmn:incoming><bpmn:outgoing>ff2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="f_envia" name="Enviar la invitación por correo"><bpmn:incoming>ff2</bpmn:incoming><bpmn:outgoing>ff3</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="f_aceptada" name="Invitación aceptada"><bpmn:incoming>ff3</bpmn:incoming><bpmn:outgoing>ff4</bpmn:outgoing><bpmn:messageEventDefinition id="f_aceptada_def"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="f_incorpora" name="Incorporar a la persona al hogar"><bpmn:incoming>ff4</bpmn:incoming><bpmn:outgoing>ff5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="f_inv_fin" name="Miembro incorporado"><bpmn:incoming>ff5</bpmn:incoming><bpmn:messageEventDefinition id="f_inv_fin_def"/></bpmn:endEvent>
<bpmn:startEvent id="f_gasto" name="Gasto y regla recibidos"><bpmn:outgoing>ff6</bpmn:outgoing><bpmn:messageEventDefinition id="f_gasto_def"/></bpmn:startEvent>
<bpmn:serviceTask id="f_valida" name="Validar la regla de aporte"><bpmn:incoming>ff6</bpmn:incoming><bpmn:outgoing>ff7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="f_valida_gw" name="¿Regla válida?"><bpmn:incoming>ff7</bpmn:incoming><bpmn:outgoing>ff8</bpmn:outgoing><bpmn:outgoing>ff9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="f_suma" name="Sumar el aporte de cada miembro a su proyección individual"><bpmn:incoming>ff8</bpmn:incoming><bpmn:outgoing>ff10</bpmn:outgoing><bpmn:dataOutputAssociation id="do_f_suma_f_comun"><bpmn:targetRef>f_comun</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="f_gasto_fin" name="Gasto común vigente"><bpmn:incoming>ff10</bpmn:incoming><bpmn:messageEventDefinition id="f_gasto_fin_def"/></bpmn:endEvent>
<bpmn:endEvent id="f_rechazo" name="Regla rechazada; se pide corregirla"><bpmn:incoming>ff9</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="f_sale" name="Solicitud de salida del hogar"><bpmn:outgoing>ff11</bpmn:outgoing><bpmn:messageEventDefinition id="f_sale_def"/></bpmn:startEvent>
<bpmn:subProcess id="sp_salida" name="Salida de un miembro"><bpmn:incoming>ff11</bpmn:incoming><bpmn:outgoing>ff12</bpmn:outgoing><bpmn:startEvent id="s_start" name=""><bpmn:outgoing>fs1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="s_quita" name="Quitar a la persona del hogar y de sus reglas"><bpmn:incoming>fs1</bpmn:incoming><bpmn:outgoing>fs2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="s_admin" name="¿Era el administrador?"><bpmn:incoming>fs2</bpmn:incoming><bpmn:outgoing>fs3</bpmn:outgoing><bpmn:outgoing>fs4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="s_promueve" name="Promover a otro miembro como administrador"><bpmn:incoming>fs3</bpmn:incoming><bpmn:outgoing>fs5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="s_merge" name=""><bpmn:incoming>fs4</bpmn:incoming><bpmn:incoming>fs5</bpmn:incoming><bpmn:outgoing>fs6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="s_reparte" name="Repartir sus aportes en partes iguales entre los demás"><bpmn:incoming>fs6</bpmn:incoming><bpmn:outgoing>fs7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="s_end" name=""><bpmn:incoming>fs7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fs1" name="" sourceRef="s_start" targetRef="s_quita"/>
<bpmn:sequenceFlow id="fs2" name="" sourceRef="s_quita" targetRef="s_admin"/>
<bpmn:sequenceFlow id="fs3" name="Sí" sourceRef="s_admin" targetRef="s_promueve"/>
<bpmn:sequenceFlow id="fs4" name="No" sourceRef="s_admin" targetRef="s_merge"/>
<bpmn:sequenceFlow id="fs5" name="" sourceRef="s_promueve" targetRef="s_merge"/>
<bpmn:sequenceFlow id="fs6" name="" sourceRef="s_merge" targetRef="s_reparte"/>
<bpmn:sequenceFlow id="fs7" name="" sourceRef="s_reparte" targetRef="s_end"/></bpmn:subProcess>
<bpmn:endEvent id="f_sale_fin" name="Hogar actualizado"><bpmn:incoming>ff12</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="ff1" name="" sourceRef="f_inv" targetRef="f_enlace"/>
<bpmn:sequenceFlow id="ff2" name="" sourceRef="f_enlace" targetRef="f_envia"/>
<bpmn:sequenceFlow id="ff3" name="" sourceRef="f_envia" targetRef="f_aceptada"/>
<bpmn:sequenceFlow id="ff4" name="" sourceRef="f_aceptada" targetRef="f_incorpora"/>
<bpmn:sequenceFlow id="ff5" name="" sourceRef="f_incorpora" targetRef="f_inv_fin"/>
<bpmn:sequenceFlow id="ff6" name="" sourceRef="f_gasto" targetRef="f_valida"/>
<bpmn:sequenceFlow id="ff7" name="" sourceRef="f_valida" targetRef="f_valida_gw"/>
<bpmn:sequenceFlow id="ff8" name="Sí" sourceRef="f_valida_gw" targetRef="f_suma"/>
<bpmn:sequenceFlow id="ff9" name="No" sourceRef="f_valida_gw" targetRef="f_rechazo"/>
<bpmn:sequenceFlow id="ff10" name="" sourceRef="f_suma" targetRef="f_gasto_fin"/>
<bpmn:dataStoreReference id="f_comun" name="Espacio común del hogar"/>
<bpmn:textAnnotation id="n_priv"><bpmn:text>La información fluye del espacio común a cada perfil, nunca al revés: nadie ve los ingresos, deudas ni escenarios de otro miembro (HU16).</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n_priv_a" sourceRef="n_priv" targetRef="f_comun"/>
<bpmn:sequenceFlow id="ff11" name="" sourceRef="f_sale" targetRef="sp_salida"/>
<bpmn:sequenceFlow id="ff12" name="" sourceRef="sp_salida" targetRef="f_sale_fin"/>
</bpmn:process>
<bpmn:process id="proc_invitado" isExecutable="false">
<bpmn:startEvent id="v_recibe" name="Invitación recibida"><bpmn:outgoing>fv1</bpmn:outgoing><bpmn:messageEventDefinition id="v_recibe_def"/></bpmn:startEvent>
<bpmn:exclusiveGateway id="v_cuenta" name="¿Tiene cuenta?"><bpmn:incoming>fv1</bpmn:incoming><bpmn:outgoing>fv2</bpmn:outgoing><bpmn:outgoing>fv3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="v_crea" name="Crear la cuenta y verificar el correo"><bpmn:incoming>fv2</bpmn:incoming><bpmn:outgoing>fv4</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="v_merge" name=""><bpmn:incoming>fv3</bpmn:incoming><bpmn:incoming>fv4</bpmn:incoming><bpmn:outgoing>fv5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="v_acepta" name="Aceptar la invitación"><bpmn:incoming>fv5</bpmn:incoming><bpmn:outgoing>fv6</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="v_fin" name="Es miembro del hogar"><bpmn:incoming>fv6</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fv1" name="" sourceRef="v_recibe" targetRef="v_cuenta"/>
<bpmn:sequenceFlow id="fv2" name="No" sourceRef="v_cuenta" targetRef="v_crea"/>
<bpmn:sequenceFlow id="fv3" name="Sí" sourceRef="v_cuenta" targetRef="v_merge"/>
<bpmn:sequenceFlow id="fv4" name="" sourceRef="v_crea" targetRef="v_merge"/>
<bpmn:sequenceFlow id="fv5" name="" sourceRef="v_merge" targetRef="v_acepta"/>
<bpmn:sequenceFlow id="fv6" name="" sourceRef="v_acepta" targetRef="v_fin"/>
</bpmn:process>
