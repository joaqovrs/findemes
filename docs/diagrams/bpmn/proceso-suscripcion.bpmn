<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_suscripcion" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_suscripcion">
<bpmn:participant id="pool_usuario" name="Usuario" processRef="proc_usuario"/>
<bpmn:participant id="pool_tbk" name="Transbank Webpay Plus"/>
<bpmn:participant id="pool_findemes" name="Fin de Mes" processRef="proc_findemes"/>
<bpmn:participant id="pool_admin" name="Administrador de la plataforma" processRef="proc_admin"/>
<bpmn:messageFlow id="m1" name="Plan elegido" sourceRef="u_elige" targetRef="f_solicitud"/>
<bpmn:messageFlow id="m2" name="Orden de compra y monto" sourceRef="p_crear" targetRef="pool_tbk"/>
<bpmn:messageFlow id="m3" name="Formulario de pago" sourceRef="pool_tbk" targetRef="u_form"/>
<bpmn:messageFlow id="m4" name="Datos de la tarjeta" sourceRef="u_tarjeta" targetRef="pool_tbk"/>
<bpmn:messageFlow id="m5" name="Código de retorno" sourceRef="pool_tbk" targetRef="p_retorno"/>
<bpmn:messageFlow id="m6" name="Confirmación del pago" sourceRef="p_commit" targetRef="pool_tbk"/>
<bpmn:messageFlow id="m7" name="Estado del plan" sourceRef="f_informa" targetRef="u_resultado"/>
</bpmn:collaboration>
<bpmn:process id="proc_usuario" isExecutable="false">
<bpmn:startEvent id="u_start" name="Necesita una capacidad del plan pagado"><bpmn:outgoing>fu1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="u_planes" name="Consultar y comparar los planes"><bpmn:incoming>fu1</bpmn:incoming><bpmn:outgoing>fu2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="u_elige" name="Elegir el plan y confirmar la contratación"><bpmn:incoming>fu2</bpmn:incoming><bpmn:outgoing>fu3</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="u_form" name="Formulario de pago abierto"><bpmn:incoming>fu3</bpmn:incoming><bpmn:outgoing>fu4</bpmn:outgoing><bpmn:messageEventDefinition id="u_form_def"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="u_tarjeta" name="Ingresar la tarjeta en el formulario de Transbank"><bpmn:incoming>fu4</bpmn:incoming><bpmn:outgoing>fu5</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="u_resultado" name="Resultado del pago recibido"><bpmn:incoming>fu5</bpmn:incoming><bpmn:outgoing>fu6</bpmn:outgoing><bpmn:messageEventDefinition id="u_resultado_def"/></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="u_activo" name="¿Plan activado?"><bpmn:incoming>fu6</bpmn:incoming><bpmn:outgoing>fu7</bpmn:outgoing><bpmn:outgoing>fu8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="u_ok" name="Plan pagado activo"><bpmn:incoming>fu7</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="u_no" name="Se mantiene el plan anterior"><bpmn:incoming>fu8</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fu1" name="" sourceRef="u_start" targetRef="u_planes"/>
<bpmn:sequenceFlow id="fu2" name="" sourceRef="u_planes" targetRef="u_elige"/>
<bpmn:sequenceFlow id="fu3" name="" sourceRef="u_elige" targetRef="u_form"/>
<bpmn:sequenceFlow id="fu4" name="" sourceRef="u_form" targetRef="u_tarjeta"/>
<bpmn:sequenceFlow id="fu5" name="" sourceRef="u_tarjeta" targetRef="u_resultado"/>
<bpmn:sequenceFlow id="fu6" name="" sourceRef="u_resultado" targetRef="u_activo"/>
<bpmn:sequenceFlow id="fu7" name="Sí" sourceRef="u_activo" targetRef="u_ok"/>
<bpmn:sequenceFlow id="fu8" name="No" sourceRef="u_activo" targetRef="u_no"/>
</bpmn:process>
<bpmn:process id="proc_findemes" isExecutable="false">
<bpmn:startEvent id="f_solicitud" name="Solicitud de contratación"><bpmn:outgoing>ff1</bpmn:outgoing><bpmn:messageEventDefinition id="f_solicitud_def"/></bpmn:startEvent>
<bpmn:subProcess id="sp_pago" name="Pagar con Webpay Plus"><bpmn:incoming>ff1</bpmn:incoming><bpmn:outgoing>ff2</bpmn:outgoing><bpmn:startEvent id="p_start" name=""><bpmn:outgoing>fp1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="p_crear" name="Crear la transacción con una orden de compra única"><bpmn:incoming>fp1</bpmn:incoming><bpmn:outgoing>fp2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="p_retorno" name="Retorno de Transbank"><bpmn:incoming>fp2</bpmn:incoming><bpmn:outgoing>fp3</bpmn:outgoing><bpmn:messageEventDefinition id="p_retorno_def"/></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="p_abortado" name="¿El usuario canceló el pago?"><bpmn:incoming>fp3</bpmn:incoming><bpmn:outgoing>fp4</bpmn:outgoing><bpmn:outgoing>fp5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="p_anulado" name="Registrar la transacción como anulada"><bpmn:incoming>fp4</bpmn:incoming><bpmn:outgoing>fp10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="p_commit" name="Confirmar el pago con Transbank desde el servidor"><bpmn:incoming>fp5</bpmn:incoming><bpmn:outgoing>fp6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="p_aprobada" name="¿Aprobada y por el monto del plan?"><bpmn:incoming>fp6</bpmn:incoming><bpmn:outgoing>fp7</bpmn:outgoing><bpmn:outgoing>fp8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="p_activar" name="Activar el período del plan (una sola vez)"><bpmn:incoming>fp7</bpmn:incoming><bpmn:outgoing>fp11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="p_rechazo" name="Registrar el rechazo o la diferencia de monto"><bpmn:incoming>fp8</bpmn:incoming><bpmn:outgoing>fp9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="p_merge2" name=""><bpmn:incoming>fp9</bpmn:incoming><bpmn:incoming>fp10</bpmn:incoming><bpmn:outgoing>fp11b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p_merge1" name=""><bpmn:incoming>fp11</bpmn:incoming><bpmn:incoming>fp11b</bpmn:incoming><bpmn:outgoing>fp12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p_end" name="Pago resuelto"><bpmn:incoming>fp12</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fp1" name="" sourceRef="p_start" targetRef="p_crear"/>
<bpmn:sequenceFlow id="fp2" name="" sourceRef="p_crear" targetRef="p_retorno"/>
<bpmn:sequenceFlow id="fp3" name="" sourceRef="p_retorno" targetRef="p_abortado"/>
<bpmn:sequenceFlow id="fp4" name="Sí" sourceRef="p_abortado" targetRef="p_anulado"/>
<bpmn:sequenceFlow id="fp5" name="No" sourceRef="p_abortado" targetRef="p_commit"/>
<bpmn:sequenceFlow id="fp6" name="" sourceRef="p_commit" targetRef="p_aprobada"/>
<bpmn:sequenceFlow id="fp7" name="Sí" sourceRef="p_aprobada" targetRef="p_activar"/>
<bpmn:sequenceFlow id="fp8" name="No" sourceRef="p_aprobada" targetRef="p_rechazo"/>
<bpmn:sequenceFlow id="fp9" name="" sourceRef="p_rechazo" targetRef="p_merge2"/>
<bpmn:sequenceFlow id="fp10" name="" sourceRef="p_anulado" targetRef="p_merge2"/>
<bpmn:sequenceFlow id="fp11" name="" sourceRef="p_activar" targetRef="p_merge1"/>
<bpmn:sequenceFlow id="fp11b" name="" sourceRef="p_merge2" targetRef="p_merge1"/>
<bpmn:sequenceFlow id="fp12" name="" sourceRef="p_merge1" targetRef="p_end"/></bpmn:subProcess>
<bpmn:serviceTask id="f_informa" name="Informar el resultado al usuario"><bpmn:incoming>ff2</bpmn:incoming><bpmn:outgoing>ff3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="f_fin" name="Solicitud atendida"><bpmn:incoming>ff3</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="f_vence" name="Termina el período pagado"><bpmn:outgoing>ff4</bpmn:outgoing><bpmn:timerEventDefinition id="f_vence_def"/></bpmn:startEvent>
<bpmn:subProcess id="sp_vencimiento" name="Vencimiento y renovación"><bpmn:incoming>ff4</bpmn:incoming><bpmn:outgoing>ff5</bpmn:outgoing><bpmn:startEvent id="v_start" name=""><bpmn:outgoing>fv1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="v_renovo" name="¿Se renovó el plan?"><bpmn:incoming>fv1</bpmn:incoming><bpmn:outgoing>fv2</bpmn:outgoing><bpmn:outgoing>fv3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="v_vigente" name="Nuevo período vigente"><bpmn:incoming>fv2</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="v_gratis" name="Pasar al plan gratuito conservando todos los datos"><bpmn:incoming>fv3</bpmn:incoming><bpmn:outgoing>fv4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="v_aviso" name="Avisar al usuario por correo"><bpmn:incoming>fv4</bpmn:incoming><bpmn:outgoing>fv5</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="v_end" name="Plan gratuito vigente"><bpmn:incoming>fv5</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fv1" name="" sourceRef="v_start" targetRef="v_renovo"/>
<bpmn:sequenceFlow id="fv2" name="Sí" sourceRef="v_renovo" targetRef="v_vigente"/>
<bpmn:sequenceFlow id="fv3" name="No" sourceRef="v_renovo" targetRef="v_gratis"/>
<bpmn:sequenceFlow id="fv4" name="" sourceRef="v_gratis" targetRef="v_aviso"/>
<bpmn:sequenceFlow id="fv5" name="" sourceRef="v_aviso" targetRef="v_end"/></bpmn:subProcess>
<bpmn:endEvent id="f_vence_fin" name="Suscripción al día"><bpmn:incoming>ff5</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="ff1" name="" sourceRef="f_solicitud" targetRef="sp_pago"/>
<bpmn:sequenceFlow id="ff2" name="" sourceRef="sp_pago" targetRef="f_informa"/>
<bpmn:sequenceFlow id="ff3" name="" sourceRef="f_informa" targetRef="f_fin"/>
<bpmn:textAnnotation id="n_idem"><bpmn:text>Restricción única sobre la orden de compra: confirmar dos veces no activa dos períodos. Nunca se guardan datos de tarjeta.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n_idem_a" sourceRef="n_idem" targetRef="p_merge2"/>
<bpmn:sequenceFlow id="ff4" name="" sourceRef="f_vence" targetRef="sp_vencimiento"/>
<bpmn:sequenceFlow id="ff5" name="" sourceRef="sp_vencimiento" targetRef="f_vence_fin"/>
</bpmn:process>
<bpmn:process id="proc_admin" isExecutable="false">
<bpmn:startEvent id="a_cierre" name="Cierre del día"><bpmn:outgoing>fa1</bpmn:outgoing><bpmn:timerEventDefinition id="a_cierre_def"/></bpmn:startEvent>
<bpmn:subProcess id="sp_conciliacion" name="Conciliar las transacciones de suscripción"><bpmn:incoming>fa1</bpmn:incoming><bpmn:outgoing>fa2</bpmn:outgoing><bpmn:startEvent id="c_start" name=""><bpmn:outgoing>fc1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="c_revisa" name="Revisar transacciones pendientes, rechazadas o con diferencia"><bpmn:incoming>fc1</bpmn:incoming><bpmn:outgoing>fc2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="c_dif" name="¿Hay diferencias?"><bpmn:incoming>fc2</bpmn:incoming><bpmn:outgoing>fc3</bpmn:outgoing><bpmn:outgoing>fc4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="c_regulariza" name="Consultar el estado en Transbank y regularizar"><bpmn:incoming>fc3</bpmn:incoming><bpmn:outgoing>fc5</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="c_merge" name=""><bpmn:incoming>fc4</bpmn:incoming><bpmn:incoming>fc5</bpmn:incoming><bpmn:outgoing>fc6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="c_registra" name="Dejar constancia en la auditoría"><bpmn:incoming>fc6</bpmn:incoming><bpmn:outgoing>fc7</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="c_end" name=""><bpmn:incoming>fc7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fc1" name="" sourceRef="c_start" targetRef="c_revisa"/>
<bpmn:sequenceFlow id="fc2" name="" sourceRef="c_revisa" targetRef="c_dif"/>
<bpmn:sequenceFlow id="fc3" name="Sí" sourceRef="c_dif" targetRef="c_regulariza"/>
<bpmn:sequenceFlow id="fc4" name="No" sourceRef="c_dif" targetRef="c_merge"/>
<bpmn:sequenceFlow id="fc5" name="" sourceRef="c_regulariza" targetRef="c_merge"/>
<bpmn:sequenceFlow id="fc6" name="" sourceRef="c_merge" targetRef="c_registra"/>
<bpmn:sequenceFlow id="fc7" name="" sourceRef="c_registra" targetRef="c_end"/></bpmn:subProcess>
<bpmn:endEvent id="a_fin" name="Transacciones conciliadas"><bpmn:incoming>fa2</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fa1" name="" sourceRef="a_cierre" targetRef="sp_conciliacion"/>
<bpmn:sequenceFlow id="fa2" name="" sourceRef="sp_conciliacion" targetRef="a_fin"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_suscripcion"><bpmndi:BPMNPlane id="plane_suscripcion" bpmnElement="collab_suscripcion">
<bpmndi:BPMNShape id="pool_usuario_di" bpmnElement="pool_usuario" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#000000" color:background-color="#FFFFFF" color:border-color="#000000"><dc:Bounds x="0" y="0" width="2040" height="250"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
