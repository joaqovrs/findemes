<bpmndi:BPMNShape id="p_retorno_di" bpmnElement="p_retorno"  bioc:fill="#FFFFFF" bioc:stroke="#03689A" color:background-color="#FFFFFF" color:border-color="#03689A"><dc:Bounds x="762" y="542" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="740" y="582" width="80" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="p_abortado_di" bpmnElement="p_abortado" isMarkerVisible="true" bioc:fill="#FFFFCC" bioc:stroke="#A6A61D" color:background-color="#FFFFCC" color:border-color="#A6A61D"><dc:Bounds x="855" y="535" width="50" height="50"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="825" y="503" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="p_anulado_di" bpmnElement="p_anulado"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="925" y="700" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="p_commit_di" bpmnElement="p_commit"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="945" y="520" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
