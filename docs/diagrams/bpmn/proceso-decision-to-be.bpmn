<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_to_be" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_to_be">
<bpmn:participant id="pool_usuario" name="Usuario" processRef="proc_usuario"/>
<bpmn:participant id="pool_findemes" name="Fin de Mes" processRef="proc_findemes"/>
<bpmn:participant id="pool_hogar" name="Administrador de hogar" processRef="proc_hogar"/>
<bpmn:messageFlow id="m1" name="Decisión y parámetros" sourceRef="u_aplicar" targetRef="f_inicio"/>
<bpmn:messageFlow id="m2" name="Proyección, indicadores y explicación" sourceRef="f_entrega" targetRef="u_resultado"/>
<bpmn:messageFlow id="m3" name="Nuevo compromiso" sourceRef="u_actualizar" targetRef="f_cambio"/>
<bpmn:messageFlow id="m4" name="Proyección actualizada" sourceRef="f_actualizada" targetRef="u_proyeccion"/>
<bpmn:messageFlow id="m5" name="Gasto común y regla" sourceRef="h_regla" targetRef="f_gasto"/>
<bpmn:messageFlow id="m6" name="Confirmación" sourceRef="f_confirma" targetRef="h_confirma"/>
</bpmn:collaboration>
<bpmn:process id="proc_usuario" isExecutable="false">
<bpmn:startEvent id="u_start" name="Surge una necesidad de gasto o crédito"><bpmn:outgoing>fu1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="u_merge" name=""><bpmn:incoming>fu1</bpmn:incoming><bpmn:incoming>fu7</bpmn:incoming><bpmn:outgoing>fu2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="u_crear" name="Crear un escenario a partir del estado base"><bpmn:incoming>fu2</bpmn:incoming><bpmn:outgoing>fu3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="u_aplicar" name="Aplicar la decisión e ingresar sus parámetros"><bpmn:incoming>fu3</bpmn:incoming><bpmn:outgoing>fu4</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="u_resultado" name="Resultados recibidos"><bpmn:incoming>fu4</bpmn:incoming><bpmn:outgoing>fu5</bpmn:outgoing><bpmn:messageEventDefinition id="u_resultado_def"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="u_revisar" name="Revisar y comparar indicadores y explicación"><bpmn:incoming>fu5</bpmn:incoming><bpmn:outgoing>fu6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="u_otra" name="¿Evaluar otra alternativa?"><bpmn:incoming>fu6</bpmn:incoming><bpmn:outgoing>fu7</bpmn:outgoing><bpmn:outgoing>fu8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="u_decidir" name="Tomar la decisión"><bpmn:incoming>fu8</bpmn:incoming><bpmn:outgoing>fu9</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="u_ejecuta" name="¿Ejecuta la decisión?"><bpmn:incoming>fu9</bpmn:incoming><bpmn:outgoing>fu10</bpmn:outgoing><bpmn:outgoing>fu11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="u_actualizar" name="Actualizar el estado base con el compromiso adquirido"><bpmn:incoming>fu10</bpmn:incoming><bpmn:outgoing>fu12</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="u_proyeccion" name="Proyección actualizada recibida"><bpmn:incoming>fu12</bpmn:incoming><bpmn:outgoing>fu13</bpmn:outgoing><bpmn:messageEventDefinition id="u_proyeccion_def"/></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="u_fin" name="Decisión reflejada en la proyección"><bpmn:incoming>fu13</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="u_descarta" name="Decisión descartada; estado base sin cambios"><bpmn:incoming>fu11</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fu1" name="" sourceRef="u_start" targetRef="u_merge"/>
<bpmn:sequenceFlow id="fu2" name="" sourceRef="u_merge" targetRef="u_crear"/>
<bpmn:sequenceFlow id="fu3" name="" sourceRef="u_crear" targetRef="u_aplicar"/>
<bpmn:sequenceFlow id="fu4" name="" sourceRef="u_aplicar" targetRef="u_resultado"/>
<bpmn:sequenceFlow id="fu5" name="" sourceRef="u_resultado" targetRef="u_revisar"/>
<bpmn:sequenceFlow id="fu6" name="" sourceRef="u_revisar" targetRef="u_otra"/>
<bpmn:sequenceFlow id="fu7" name="Sí" sourceRef="u_otra" targetRef="u_merge"/>
<bpmn:sequenceFlow id="fu8" name="No" sourceRef="u_otra" targetRef="u_decidir"/>
<bpmn:sequenceFlow id="fu9" name="" sourceRef="u_decidir" targetRef="u_ejecuta"/>
<bpmn:sequenceFlow id="fu10" name="Sí" sourceRef="u_ejecuta" targetRef="u_actualizar"/>
<bpmn:sequenceFlow id="fu11" name="No" sourceRef="u_ejecuta" targetRef="u_descarta"/>
<bpmn:sequenceFlow id="fu12" name="" sourceRef="u_actualizar" targetRef="u_proyeccion"/>
<bpmn:sequenceFlow id="fu13" name="" sourceRef="u_proyeccion" targetRef="u_fin"/>
<bpmn:textAnnotation id="n_decide"><bpmn:text>La decisión es del usuario: el sistema calcula y muestra, no recomienda.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n_decide_a" sourceRef="n_decide" targetRef="u_decidir"/>
</bpmn:process>
<bpmn:process id="proc_findemes" isExecutable="false">
<bpmn:startEvent id="f_inicio" name="Decisión recibida"><bpmn:outgoing>ff1</bpmn:outgoing><bpmn:messageEventDefinition id="f_inicio_def"/></bpmn:startEvent>
<bpmn:exclusiveGateway id="f_hogar" name="¿Pertenece a un hogar?"><bpmn:incoming>ff1</bpmn:incoming><bpmn:outgoing>ff2</bpmn:outgoing><bpmn:outgoing>ff3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="f_aporte" name="Incorporar el aporte al hogar según las reglas vigentes"><bpmn:incoming>ff2</bpmn:incoming><bpmn:outgoing>ff4</bpmn:outgoing><bpmn:dataInputAssociation id="di_aporte"><bpmn:sourceRef>f_reglas</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="f_merge" name=""><bpmn:incoming>ff3</bpmn:incoming><bpmn:incoming>ff4</bpmn:incoming><bpmn:outgoing>ff5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="f_copia" name="Aplicar la decisión sobre una copia del estado base"><bpmn:incoming>ff5</bpmn:incoming><bpmn:outgoing>ff6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="f_calculo" name="Calcular la proyección y los indicadores"><bpmn:incoming>ff6</bpmn:incoming><bpmn:outgoing>ff7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="f_explica" name="Generar la explicación descriptiva"><bpmn:incoming>ff7</bpmn:incoming><bpmn:outgoing>ff8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="f_entrega" name="Resultados entregados sin ordenar ni recomendar"><bpmn:incoming>ff8</bpmn:incoming><bpmn:messageEventDefinition id="f_entrega_def"/></bpmn:endEvent>
<bpmn:startEvent id="f_cambio" name="Cambio en el estado base recibido"><bpmn:outgoing>ff9</bpmn:outgoing><bpmn:messageEventDefinition id="f_cambio_def"/></bpmn:startEvent>
<bpmn:serviceTask id="f_registra" name="Registrar el cambio en el estado base"><bpmn:incoming>ff9</bpmn:incoming><bpmn:outgoing>ff10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="f_recalcula" name="Recalcular la proyección"><bpmn:incoming>ff10</bpmn:incoming><bpmn:outgoing>ff11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="f_actualizada" name="Proyección actualizada entregada"><bpmn:incoming>ff11</bpmn:incoming><bpmn:messageEventDefinition id="f_actualizada_def"/></bpmn:endEvent>
<bpmn:startEvent id="f_gasto" name="Gasto común y regla recibidos"><bpmn:outgoing>ff12</bpmn:outgoing><bpmn:messageEventDefinition id="f_gasto_def"/></bpmn:startEvent>
<bpmn:serviceTask id="f_guarda" name="Validar y guardar el gasto y su regla de aporte"><bpmn:incoming>ff12</bpmn:incoming><bpmn:outgoing>ff13</bpmn:outgoing><bpmn:dataOutputAssociation id="do_guarda"><bpmn:targetRef>f_reglas</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="f_confirma" name="Registro confirmado"><bpmn:incoming>ff13</bpmn:incoming><bpmn:messageEventDefinition id="f_confirma_def"/></bpmn:endEvent>
<bpmn:sequenceFlow id="ff1" name="" sourceRef="f_inicio" targetRef="f_hogar"/>
<bpmn:sequenceFlow id="ff2" name="Sí" sourceRef="f_hogar" targetRef="f_aporte"/>
<bpmn:sequenceFlow id="ff3" name="No" sourceRef="f_hogar" targetRef="f_merge"/>
<bpmn:sequenceFlow id="ff4" name="" sourceRef="f_aporte" targetRef="f_merge"/>
<bpmn:sequenceFlow id="ff5" name="" sourceRef="f_merge" targetRef="f_copia"/>
<bpmn:sequenceFlow id="ff6" name="" sourceRef="f_copia" targetRef="f_calculo"/>
<bpmn:sequenceFlow id="ff7" name="" sourceRef="f_calculo" targetRef="f_explica"/>
<bpmn:sequenceFlow id="ff8" name="" sourceRef="f_explica" targetRef="f_entrega"/>
<bpmn:sequenceFlow id="ff9" name="" sourceRef="f_cambio" targetRef="f_registra"/>
<bpmn:sequenceFlow id="ff10" name="" sourceRef="f_registra" targetRef="f_recalcula"/>
<bpmn:sequenceFlow id="ff11" name="" sourceRef="f_recalcula" targetRef="f_actualizada"/>
<bpmn:sequenceFlow id="ff12" name="" sourceRef="f_gasto" targetRef="f_guarda"/>
<bpmn:sequenceFlow id="ff13" name="" sourceRef="f_guarda" targetRef="f_confirma"/>
<bpmn:dataStoreReference id="f_reglas" name="Gastos comunes y reglas de aporte vigentes"/>
<bpmn:textAnnotation id="n_pre"><bpmn:text>Precondición: sesión iniciada y estado base registrado (HU01-HU04).</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n_pre_a" sourceRef="n_pre" targetRef="f_inicio"/>
<bpmn:textAnnotation id="n_hogar"><bpmn:text>No espera a otros miembros: usa la regla vigente del gasto común.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="n_hogar_a" sourceRef="n_hogar" targetRef="f_aporte"/>
</bpmn:process>
<bpmn:process id="proc_hogar" isExecutable="false">
<bpmn:startEvent id="h_inicio" name="Hay un gasto común nuevo o modificado"><bpmn:outgoing>fh1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="h_registra" name="Registrar el gasto común"><bpmn:incoming>fh1</bpmn:incoming><bpmn:outgoing>fh2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="h_regla" name="Configurar la regla de aporte"><bpmn:incoming>fh2</bpmn:incoming><bpmn:outgoing>fh3</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="h_confirma" name="Confirmación recibida"><bpmn:incoming>fh3</bpmn:incoming><bpmn:outgoing>fh4</bpmn:outgoing><bpmn:messageEventDefinition id="h_confirma_def"/></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="h_fin" name="Gasto común vigente para todos los miembros"><bpmn:incoming>fh4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fh1" name="" sourceRef="h_inicio" targetRef="h_registra"/>
<bpmn:sequenceFlow id="fh2" name="" sourceRef="h_registra" targetRef="h_regla"/>
<bpmn:sequenceFlow id="fh3" name="" sourceRef="h_regla" targetRef="h_confirma"/>
<bpmn:sequenceFlow id="fh4" name="" sourceRef="h_confirma" targetRef="h_fin"/>
</bpmn:process>
