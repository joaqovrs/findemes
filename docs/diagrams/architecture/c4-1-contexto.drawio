<mxfile host="drawio"><diagram name="c4-1-contexto" id="c4-1-contexto"><mxGraphModel adaptiveColors="auto" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;[Diagrama de contexto del sistema] Fin de Mes&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Nivel 1 del modelo C4 · ambiente de integración · 20-10-2026&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="60" as="geometry"/></mxCell><mxCell id="usr" value="&lt;b style=&quot;font-size:12px&quot;&gt;Usuario registrado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Registra su situación financiera y simula decisiones." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="240" height="240" as="geometry"/></mxCell><mxCell id="vis" value="&lt;b style=&quot;font-size:12px&quot;&gt;Visitante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Prueba el simulador y conoce los planes sin crear cuenta." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="240" height="240" as="geometry"/></mxCell><mxCell id="mem" value="&lt;b style=&quot;font-size:12px&quot;&gt;Miembro del hogar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Comparte gastos comunes; sus datos individuales siguen siendo privados." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="240" height="240" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b style=&quot;font-size:12px&quot;&gt;Administrador de la plataforma&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Operador interno del equipo." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="240" height="240" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b style=&quot;font-size:16px&quot;&gt;Fin de Mes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Registra ingresos, gastos y deudas, proyecta el saldo mes a mes y simula decisiones con una explicación.&lt;br&gt;Describe efectos: no recomienda, no mueve dinero y no almacena tarjetas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="1000" height="200" as="geometry"/></mxCell><mxCell id="fin" value="&lt;b style=&quot;font-size:12px&quot;&gt;Fintoc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · modo de prueba]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Agregador bancario chileno. Su widget recibe la clave bancaria del usuario; entrega cuentas y movimientos de solo lectura." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="360" height="200" as="geometry"/></mxCell><mxCell id="tbk" value="&lt;b style=&quot;font-size:12px&quot;&gt;Transbank Webpay Plus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · ambiente de integración]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Pasarela de pago. Recibe los datos de tarjeta en su propio formulario." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="400" height="170" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b style=&quot;font-size:12px&quot;&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · correo transaccional]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Entrega a los usuarios correos de verificación, restablecimiento e invitación." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1160" y="900" width="400" height="170" as="geometry"/></mxCell><mxCell id="r1" value="Registra su situación,&lt;br&gt;simula decisiones y&lt;br&gt;compara escenarios&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="usr" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="Ingresa su clave&lt;br&gt;bancaria en el widget&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#C0392B;strokeWidth=2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8333;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="usr" target="fin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="300"/></Array></mxGeometry></mxCell><mxCell id="r3" value="Paga el plan&lt;br&gt;en el formulario&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#1F77B4;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="usr" target="tbk"><mxGeometry relative="1" as="geometry" x="-0.62"></mxGeometry></mxCell><mxCell id="r4" value="Prueba el modo&lt;br&gt;demostración y&lt;br&gt;consulta los planes&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.28;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vis" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value="Registra gastos&lt;br&gt;comunes y reglas&lt;br&gt;de aporte&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.58;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mem" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r6" value="Gestiona cuentas, concilia&lt;br&gt;pagos y revisa la auditoría&lt;br&gt;(TOTP)&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS sobre Tailscale]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#D68910;strokeWidth=2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.88;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7" value="Lee cuentas y&lt;br&gt;movimientos&lt;br&gt;(solo lectura)&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS/JSON]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="fin"><mxGeometry relative="1" as="geometry" x="0.35"></mxGeometry></mxCell><mxCell id="r8" value="Crea y confirma (commit)&lt;br&gt;transacciones&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS/JSON]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.14;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="tbk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r9" value="Envía correos&lt;br&gt;transaccionales&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E2;fontColor=#33506B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1640" y="100" width="330" height="278" as="geometry"/></mxCell><mxCell id="lg0s" value="" style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="legend"><mxGeometry x="14" y="34" width="70" height="26" as="geometry"/></mxCell><mxCell id="lg0t" value="Persona" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend"><mxGeometry x="96" y="32" width="224" height="30" as="geometry"/></mxCell><mxCell id="lg1s" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ff