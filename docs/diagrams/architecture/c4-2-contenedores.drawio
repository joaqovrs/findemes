t;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#C0392B;strokeWidth=2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1562;exitY=1;exitDx=0;exitDy=0;entryX=0.2059;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="fin"><mxGeometry relative="1" as="geometry" x="-0.5"></mxGeometry></mxCell><mxCell id="r7" value="Redirige al&lt;br&gt;formulario de pago&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#1F77B4;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.4688;exitY=1;exitDx=0;exitDy=0;entryX=0.1765;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="tbk"><mxGeometry relative="1" as="geometry" x="-0.15"><Array as="points"><mxPoint x="230" y="1120"/><mxPoint x="540" y="1120"/></Array></mxGeometry></mxCell><mxCell id="r8" value="Crea el Link Intent, canjea&lt;br&gt;el token y lee movimientos&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS/JSON]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1176;exitY=1;exitDx=0;exitDy=0;entryX=0.8235;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="fin"><mxGeometry relative="1" as="geometry" x="-0.75"><Array as="points"><mxPoint x="500" y="1080"/><mxPoint x="340" y="1080"/></Array></mxGeometry></mxCell><mxCell id="r9" value="Crea y confirma&lt;br&gt;(commit) transacciones&lt;br&gt;&lt;span style=&quot;font-size:9px&quo