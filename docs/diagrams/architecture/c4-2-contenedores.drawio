<mxfile host="drawio"><diagram name="c4-2-contenedores" id="c4-2-contenedores"><mxGraphModel adaptiveColors="auto" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;[Diagrama de contenedores] Fin de Mes&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Nivel 2 del modelo C4 · ambiente de integración · 20-10-2026&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="60" as="geometry"/></mxCell><mxCell id="vis" value="&lt;b style=&quot;font-size:12px&quot;&gt;Visitante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Sin cuenta." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="220" height="210" as="geometry"/></mxCell><mxCell id="usr" value="&lt;b style=&quot;font-size:12px&quot;&gt;Usuario registrado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Incluye a los miembros de un hogar." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="220" height="210" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b style=&quot;font-size:12px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Desde un equipo de la tailnet." style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1570" y="90" width="220" height="210" as="geometry"/></mxCell><mxCell id="sb" value="&lt;b&gt;Fin de Mes&lt;/b&gt;&lt;br&gt;[Sistema de software]" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacing=10;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1920" height="680" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Flutter web, sitio estático]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Interfaz para navegador. No recalcula: consume la API." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="sb"><mxGeometry x="40" y="60" width="320" height="170" as="geometry"/></mxCell><mxCell id="mob" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aplicación móvil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Flutter, Android 10+ e iOS 15+]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Misma base de código. Guarda el refresh en flutter_secure_storage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="sb"><mxGeometry x="420" y="60" width="320" height="170" as="geometry"/></mxCell><mxCell id="mig" value="&lt;b style=&quot;font-size:12px&quot;&gt;Migrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Kysely + SQL, job previo al despliegue]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Aplica migraciones y crea los roles por servicio." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="sb"><mxGeometry x="940" y="60" width="320" height="150" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:12px&quot;&gt;API pública&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Node.js 24, TypeScript, Fastify]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Expone /v1 (OpenAPI). Contiene los módulos y el motor de simulación, que se ejecuta en proceso. Sin estado; varias instancias." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="sb"><mxGeometry x="420" y="340" width="340" height="200" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:12px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: PostgreSQL 18 gestionado]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Estado base, escenarios, hogares, suscripciones y auditoría encadenada por hash. RLS y un rol por servicio." style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=11;spacing=6;" vertex="1" parent="sb"><mxGeometry x="940" y="330" width="320" height="220" as="geometry"/></mxCell><mxCell id="ab" value="&lt;b&gt;Plano de administración&lt;/b&gt;&lt;br&gt;[solo alcanzable por Tailscale · RNF21]" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D68910;fontColor=#A6610A;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacing=10;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="sb"><mxGeometry x="1360" y="30" width="520" height="610" as="geometry"/></mxCell><mxCell id="pan" value="&lt;b style=&quot;font-size:12px&quot;&gt;Panel de administración&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: aplicación web, tecnología por definir]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Cuentas, planes, conciliación y auditoría. Sin datos financieros." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;dashed=1;dashPattern=8 4;" vertex="1" parent="ab"><mxGeometry x="60" y="40" width="400" height="170" as="geometry"/></mxCell><mxCell id="aapi" value="&lt;b style=&quot;font-size:12px&quot;&gt;API de administración&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Node.js 24, Fastify]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Proceso separado de la API pública. Exige TOTP." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="ab"><mxGeometry x="60" y="320" width="400" height="170" as="geometry"/></mxCell><mxCell id="fin" value="&lt;b style=&quot;font-size:12px&quot;&gt;Fintoc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · modo de prueba]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Widget de vinculación y API de movimientos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1180" width="340" height="140" as="geometry"/></mxCell><mxCell id="tbk" value="&lt;b style=&quot;font-size:12px&quot;&gt;Transbank Webpay Plus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · integración]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Formulario de pago y API." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="1180" width="340" height="140" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b style=&quot;font-size:12px&quot;&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo · correo transaccional]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Verificación, recuperación e invitaciones." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="1180" width="340" height="140" as="geometry"/></mxCell><mxCell id="r1" value="Prueba el modo&lt;br&gt;demostración&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4688;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vis" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="Usa&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=10;fontColor=#404040;strokeColor=#707070;strokeWidth=1.2;rounded=1;arcSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.2273;exitY=1;exitDx=0;exitDy=0;entryX=0.875;entryY