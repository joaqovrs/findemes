<mxfile host="drawio"><diagram name="c4-3-componentes-api" id="c4-3-componentes-api"><mxGraphModel adaptiveColors="auto" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;[Diagrama de componentes] Fin de Mes · API pública, en capas hexagonales&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Nivel 3 del modelo C4 · las dependencias apuntan hacia el dominio · 20-10-2026&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="60" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aplicación web y móvil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Flutter]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Cliente externo. No recalcula." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="340" height="120" as="geometry"/></mxCell><mxCell id="cb" value="&lt;b&gt;API pública&lt;/b&gt;&lt;br&gt;[Contenedor: Node.js 24, TypeScript, Fastify]" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacing=10;fontSize=11;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="2346" height="1350" as="geometry"/></mxCell><mxCell id="b1" value="Adaptadores de entrada · api/v1, http" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FB;strokeColor=#C9D6E2;fontColor=#33506B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="cb"><mxGeometry x="20" y="30" width="2286" height="190" as="geometry"/></mxCell><mxCell id="ctl" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controladores REST /v1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Fastify + Zod · previsto]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Traducen HTTP a casos de uso; rechazan campos desconocidos; generan openapi.yaml." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#63BEF2;strokeColor=#2086C9;fontColor=#000000;dashed=1;dashPattern=8 4;" vertex="1" parent="b1"><mxGeometry x="40" y="40" width="400" height="130" as="geometry"/></mxCell><mxCell id="pip" value="&lt;b style=&quot;font-size:12px&quot;&gt;Pipeline de entrada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: hooks de Fastify · previsto]&lt;/span&gt;&lt;br&gt;&lt;br&gt;1 límite de tasa → 2 esquema estricto → 3 JWT (algoritmo fijo; iss, aud, exp) → Actor.&lt;br&gt;Rutas autenticadas · públicas con límite (demo, registro, login, enlaces) · retorno de Webpay, verificado con el commit." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#63BEF2;strokeColor=#2086C9;fontColor=#000000;dashed=1;dashPattern=8 4;" vertex="1" parent="b1"><mxGeometry x="520" y="30" width="640" height="150" as="geometry"/></mxCell><mxCell id="err" value="&lt;b style=&quot;font-size:12px&quot;&gt;Errores uniformes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: http/ · implementado]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Formato único; 404 ante recursos ajenos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;absoluteArcSize=1;labelBackgroundColor=none;align=center;verticalAlign=middle;spacing=8;fontSize=11;fillColor=#63BEF2;strokeColor=#2086C9;fontColor=#000000;" vertex="1" parent="b1"><mxGeo