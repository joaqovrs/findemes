@startuml comp-2-api-publica
!include ../uml-style.iuml
title Diagrama de componentes · Interior de la API pública (arquitectura hexagonal)
top to bottom direction
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70
skinparam packageStyle rectangle

interface "API REST /v1" as IREST

component "API pública" {
  package "1. Adaptadores de entrada" as L1 {
    component "Controladores REST\n<size:10>reciben y validan cada solicitud</size>" <<previsto>> as CTL
    component "Errores HTTP uniformes" as HTTP
  }

  package "2. Casos de uso (un módulo por área)" as L2 {
    component "Identidad" <<previsto>> as IDN
    component "Registro\nfinanciero" <<previsto>> as REG
    component "Escenarios" <<previsto>> as SCN
    component "Hogar" <<previsto>> as HOG
    component "Suscripción" <<previsto>> as SUB
    component "Agregación\nbancaria" <<previsto>> as AGG
    component "Privacidad" <<previsto>> as PRV
    component "Auditoría" <<previsto>> as AUD
    component "Demostración" <<previsto>> as DEM
  }

  package "3. Núcleo" as L3 {
    component "Motor de simulación\n<size:10>cálculo puro y determinista</size>" <<núcleo>> as CORE
    interface "Simulación" as ISIM
  }

  package "4. Puertos (interfaces que definen los módulos)" as L4 {
    interface "Persistencia" as P_DB
    interface "Seguridad de acceso" as P_SEC
    interface "Envío de correo" as P_MAIL
    interface "Pasarela de pago" as P_PAY
    interface "Agregador bancario" as P_BANK
  }

  package "5. Adaptadores de salida" as L5 {
    component "PostgreSQL\n<size:10>consultas filtradas por usuario</size>" <<previsto>> as A_PG
    component "Seguridad\n<size:10>argon2id y emisión de sesiones</size>" <<previsto>> as A_SEC
    component "Correo transaccional" <<previsto>> as A_MAIL
    component "Webpay Plus" <<previsto>> as A_WP
    component "Fintoc" <<previsto>> as A_FIN
    component "Banco de demostración" as A_DEMO
  }

  component "Raíz de composición\n<size:10>conecta cada puerto con su adaptador</size>" as COMP
}

' Vertical order of the layers.
IREST -down- CTL
CTL .down.> L2 : invoca
CTL .right.> HTTP
L2 .down.> P_DB : guardan y leen\n(todos salvo Demostración)

' Core.
CORE -up- ISIM
REG .down.> ISIM
SCN .down.> ISIM
DEM .down.> ISIM

' Specific ports.
IDN .down.> P_SEC
IDN .down.> P_MAIL
HOG .down.> P_MAIL
SUB .down.> P_PAY
AGG .down.> P_BANK

' Adapters implement the ports.
A_PG -up- P_DB
A_SEC -up- P_SEC
A_MAIL -up- P_MAIL
A_WP -up- P_PAY
A_FIN -up- P_BANK
A_DEMO -up- P_BANK

COMP ..> L5 : construye
COMP ..> L1 : construye

legend right
  <b>Notación UML 2.5</b>
  Bola = interfaz que ofrece un componente.
  Flecha discontinua = el componente necesita esa interfaz.
  Borde discontinuo «previsto» = diseñado, aún no implementado.
  Las dependencias apuntan siempre hacia el núcleo:
  cambiar Fintoc por el banco de demostración
  no modifica los casos de uso ni el motor.
end legend
@enduml
